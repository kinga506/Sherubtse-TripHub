<%- include('../partials/header') %>
<h1>Account Settings → Security → Change Password</h1>
<% if(error){ %><p role="alert"><%= error %></p><% } %>
<form method="post" action="/auth/change-password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Current password <input type="password" name="currentPassword" autocomplete="current-password" required></label>
  <label>New password <input type="password" name="newPassword" autocomplete="new-password" minlength="12" maxlength="72" required></label>
  <label>Confirm new password <input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" maxlength="72" required></label>
  <button type="submit">Change password</button>
</form>
<p>Changing your password signs you out on every device.</p>
<%- include('../partials/footer') %>
