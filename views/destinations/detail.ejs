<%- include('../partials/header') %>
<nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/destinations">Destinations</a> <span aria-hidden="true">/</span> <span aria-current="page"><%= destination.name %></span></nav>

<header class="destination-hero">
 <div class="destination-hero-copy"><p class="eyebrow"><%= destination.dzongkhag %></p><h1><%= destination.name %></h1><p class="lead"><%= destination.description %></p><a class="btn btn-primary" href="#destination-guide">Read the destination guide <span aria-hidden="true">↓</span></a></div>
 <figure class="destination-hero-photo">
  <% if (photos.length) { %><button class="photo-open" type="button" data-lightbox-open data-photo-src="<%= photos[0].file_path %>" data-photo-alt="<%= photos[0].alt_text %>" aria-label="Expand photograph: <%= photos[0].alt_text %>"><img src="<%= photos[0].file_path %>" alt="<%= photos[0].alt_text %>" fetchpriority="high"></button><figcaption><%= photos[0].photo_credit ? `Photo: ${photos[0].photo_credit}` : 'Photograph supplied with project references; attribution not provided' %></figcaption>
  <% } else { %><img src="/images/destination-placeholder.svg" alt="No destination photograph available for <%= destination.name %>"><figcaption>Destination photograph unavailable</figcaption><% } %>
 </figure>
</header>

<% if(seasonWarning){ %><div class="alert alert-warning destination-season-note" role="note"><strong>Seasonal / access notice:</strong> <%= seasonWarning %></div><% } %>

<% const guide = destination.guide_content || {}; %>
<main id="destination-guide" class="destination-guide">
 <section class="destination-reading-section" aria-labelledby="about-destination"><div class="destination-section-heading"><p class="eyebrow">A place to discover</p><h2 id="about-destination">About <%= destination.name %></h2></div><p class="destination-prose"><%= guide.overview || destination.description %></p></section>

 <section class="destination-reading-section destination-significance" aria-labelledby="destination-significance-heading"><div class="destination-section-heading"><p class="eyebrow">Culture, history and nature</p><h2 id="destination-significance-heading">Why this place matters</h2></div><p class="destination-prose"><%= guide.significance || 'Local history and cultural context are being prepared.' %></p></section>

 <section class="destination-reading-section" aria-labelledby="destination-highlights-heading"><div class="destination-section-heading"><p class="eyebrow">Explore with care</p><h2 id="destination-highlights-heading">Highlights and experiences</h2></div><div class="destination-highlight-grid"><% (guide.highlights || []).forEach((item,index) => { %><article class="destination-highlight-card"><span aria-hidden="true" class="destination-highlight-number"><%= String(index+1).padStart(2,'0') %></span><h3><%= item.title %></h3><p><%= item.detail %></p></article><% }) %></div></section>

 <section class="destination-reading-section" aria-labelledby="practical-info-heading"><div class="destination-section-heading"><p class="eyebrow">Plan thoughtfully</p><h2 id="practical-info-heading">Practical information</h2></div><div class="destination-practical-grid">
  <article class="destination-info-card"><h3>Best time to visit</h3><p><%= guide.bestTime || destination.best_season || 'Confirm the best season with local authorities.' %></p></article>
  <article class="destination-info-card"><h3>Getting there from Kanglung</h3><p><%= guide.gettingThere || destination.transport || 'Confirm transport and access locally.' %></p></article>
  <article class="destination-info-card"><h3>Distance and travel estimates</h3><dl class="destination-facts"><div><dt>Distance</dt><dd><%= destination.distance_text || 'Not listed' %></dd></div><div><dt>Driving time</dt><dd><%= destination.drive_time_text || 'Not listed' %></dd></div><% if(destination.trek_time_text){ %><div><dt>Walking / trekking time</dt><dd><%= destination.trek_time_text %></dd></div><% } %><div><dt>Shared transport estimate per student</dt><dd><%= destination.transport_cost_min!=null && destination.transport_cost_max!=null ? `Nu. ${Number(destination.transport_cost_min).toLocaleString('en-US')}–${Number(destination.transport_cost_max).toLocaleString('en-US')}` : 'Not listed' %></dd></div><div><dt>Entry / access</dt><dd><%= destination.entry_fee_note || 'Confirm with local authorities.' %></dd></div></dl><p class="small-muted">Transport amounts and travel times are preliminary source estimates, not official fares or live directions.</p></article>
 </div></section>

 <section class="destination-reading-section destination-guidance-grid" aria-label="Student travel guidance">
  <article class="destination-info-card"><p class="eyebrow">Before you go</p><h2>Student travel tips</h2><ul class="destination-guidance-list"><% (guide.studentTips || []).forEach(tip => { %><li><%= tip %></li><% }) %></ul><% if(destination.practical_tip){ %><p class="destination-source-tip"><strong>Source guide tip:</strong> <%= destination.practical_tip %></p><% } %></article>
  <article class="destination-safety-card"><p class="eyebrow">Travel responsibly</p><h2>Safety and local respect</h2><p><%= guide.safety || 'Check current conditions, local rules, and institutional travel approval before departure.' %></p></article>
 </section>

 <section class="section-block destination-trips" aria-labelledby="trips-heading"><div class="section-heading"><div><p class="eyebrow">DSA-approved listings only</p><h2 id="trips-heading">College trips to this destination</h2></div></div>
 <% if(trips.length){ %><div class="trip-preview-grid"><% trips.forEach(trip=>{ %><article class="surface-card"><span class="status-badge <%= trip.public_stage==='ongoing'?'badge-success':'badge-info' %>"><%= trip.public_stage==='ongoing'?'Ongoing':'Upcoming' %></span><h3><%= trip.title %></h3><p><%= trip.description %></p><p><strong>Dates:</strong> <%= new Date(trip.start_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %> – <%= new Date(trip.end_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %></p><p><strong>Estimated total per student:</strong> Nu. <%= Number(trip.estimated_cost).toLocaleString('en-US') %></p><p><strong>Places:</strong> <%= trip.occupied_seats %>/<%= trip.max_participants %> occupied · <%= trip.confirmed_participants %> confirmed · <%= trip.registration.available %> available</p><span class="status-badge <%= trip.registration.key==='open'?'badge-success':'badge-neutral' %>"><%= trip.registration.label %></span><p><a class="text-link" href="/trips/<%= trip.id %>">View public trip details →</a></p></article><% }) %></div>
 <% } else { %><div class="empty-state"><h3>No college trips available</h3><p>DSA-approved college trips will appear here when announced. Please check back for upcoming journeys.</p></div><% } %>
 </section>

 <% if(guide.sources && guide.sources.length){ %><section class="destination-source-section" aria-labelledby="destination-sources-heading"><h2 id="destination-sources-heading">Sources and further information</h2><p>External sources support the historical, cultural, and conservation context. Route, timing, and cost figures remain estimates from the supplied project guide and should be confirmed locally.</p><ul><% guide.sources.forEach(source => { %><li><% if(source.url){ %><a href="<%= source.url %>" target="_blank" rel="noopener noreferrer"><%= source.label %></a><% } else { %><%= source.reference %><% } %></li><% }) %></ul></section><% } %>
</main>
<p><a href="/destinations" class="btn btn-outline">← Back to all destinations</a></p>
<dialog id="photo-lightbox" class="photo-lightbox" aria-label="Destination photograph"><button type="button" class="photo-lightbox-close" data-lightbox-close aria-label="Close photograph">×</button><img alt="" src="/images/destination-placeholder.svg"><p class="photo-lightbox-caption"></p></dialog>
<script defer src="/js/destinations.js"></script>
<%- include('../partials/footer') %>
