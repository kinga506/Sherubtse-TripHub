<%- include('../partials/header') %>
<nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a> / <a href="/destinations">Destinations</a> / <span aria-current="page"><%= destination.name %></span></nav>
<header class="page-heading"><p class="eyebrow"><%= destination.dzongkhag %></p><h1><%= destination.name %></h1><p class="lead"><%= destination.description %></p></header>
<% if (photos.length) { %>
<section aria-labelledby="gallery-title"><h2 class="sr-only" id="gallery-title">Destination photography</h2><div class="photo-gallery">
 <% photos.forEach((photo,index) => { %><figure><button class="photo-open" type="button" data-lightbox-open data-photo-src="<%= photo.file_path %>" data-photo-alt="<%= photo.alt_text %>" aria-label="Expand photograph: <%= photo.alt_text %>"><img src="<%= photo.file_path %>" alt="<%= photo.alt_text %>" loading="<%= index===0?'eager':'lazy' %>"></button><figcaption><%= photo.photo_credit ? `Photo: ${photo.photo_credit}` : 'Photograph supplied with project references; attribution not provided' %></figcaption></figure><% }) %>
</div></section>
<% } %>
<% if(seasonWarning){ %><div class="alert alert-warning" role="note"><strong>Seasonal / access notice:</strong> <%= seasonWarning %></div><% } %>
<div class="destination-details-layout"><section class="surface-card"><h2>Plan your visit</h2><dl class="detail-list"><div><dt>Best season</dt><dd><%= destination.best_season || 'Check locally' %></dd></div><div><dt>Transport</dt><dd><%= destination.transport || 'Check locally' %></dd></div><div><dt>Distance from Sherubtse</dt><dd><%= destination.distance_text || 'Not listed' %></dd></div><div><dt>Driving time</dt><dd><%= destination.drive_time_text || 'Not listed' %></dd></div><% if(destination.trek_time_text){ %><div><dt>Trekking time</dt><dd><%= destination.trek_time_text %></dd></div><% } %><div><dt>Estimated shared transport cost per student</dt><dd><%= destination.transport_cost_min!=null && destination.transport_cost_max!=null ? `Nu. ${Number(destination.transport_cost_min).toLocaleString('en-US')}–${Number(destination.transport_cost_max).toLocaleString('en-US')}` : 'Not listed' %></dd></div><div><dt>Entry fee / access</dt><dd><%= destination.entry_fee_note || 'Confirm with local authorities' %></dd></div></dl></section>
<aside class="surface-card"><h2>Practical guidance</h2><p><%= destination.practical_tip || 'Check local travel conditions before visiting.' %></p><% if(destination.travel_note){ %><p><%= destination.travel_note %></p><% } %><p class="small-muted">Transport estimates are preliminary shared budgets, not verified public fares. Driving and trekking times are separate. Check weather, roads, permits and other restrictions.</p></aside></div>
<section class="section-block" aria-labelledby="trips-heading"><div class="section-heading"><div><p class="eyebrow">DSA-approved listings only</p><h2 id="trips-heading">College trips to this destination</h2></div></div>
<% if(trips.length){ %><div class="trip-preview-grid"><% trips.forEach(trip=>{ %><article class="surface-card"><span class="status-badge <%= trip.public_stage==='ongoing'?'badge-success':'badge-info' %>"><%= trip.public_stage==='ongoing'?'Ongoing':'Upcoming' %></span><h3><%= trip.title %></h3><p><%= trip.description %></p><p><strong>Dates:</strong> <%= new Date(trip.start_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %> – <%= new Date(trip.end_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %></p><p><strong>Estimated total per student:</strong> Nu. <%= Number(trip.estimated_cost).toLocaleString('en-US') %></p><p><strong>Places:</strong> <%= trip.occupied_seats %>/<%= trip.max_participants %> occupied · <%= trip.confirmed_participants %> confirmed · <%= trip.registration.available %> available</p><span class="status-badge <%= trip.registration.key==='open'?'badge-success':'badge-neutral' %>"><%= trip.registration.label %></span><p><a class="text-link" href="/trips/<%= trip.id %>">View public trip details →</a></p></article><% }) %></div>
<% } else { %><div class="empty-state"><h3>No college trips available</h3><p>DSA-approved college trips will appear here when announced. Please check back for upcoming journeys.</p></div><% } %>
</section>
<p><a href="/destinations" class="btn btn-outline">← Back to all destinations</a></p>
<dialog id="photo-lightbox" class="photo-lightbox" aria-label="Destination photograph"><button type="button" class="photo-lightbox-close" data-lightbox-close aria-label="Close photograph">×</button><img alt="" src="/images/destination-placeholder.svg"><p class="photo-lightbox-caption"></p></dialog>
<script defer src="/js/destinations.js"></script>
<%- include('../partials/footer') %>
