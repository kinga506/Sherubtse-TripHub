<%- include('../partials/header') %>

<% if (submittedNow) { %>

  <div class="form-message" role="status">
    <strong>Trip proposal submitted successfully!</strong>

    <p>
      Your proposal has been forwarded to DSA
      and is now pending review.
    </p>

    <a href="/workspace/my-trips#my-proposals">
      View My Trip Proposal Status
    </a>
  </div>

<% } else if (trip.approval_status === 'pending_dsa') { %>

  <div class="form-message" role="status">
    <strong>Pending DSA Review</strong>

    <p>
      Your proposal has already been submitted to DSA.
      Please wait for the review decision.
    </p>

    <a href="/workspace/my-trips#my-proposals">
      Check Proposal Status
    </a>
  </div>

<% } %>

<div class="page-heading"><p class="eyebrow">Private proposal preview</p><h1><%= trip.title %></h1><p class="lead">Status: <%= trip.approval_status.replaceAll('_',' ') %>. This preview is not an official DSA submission or approval.</p></div>

<% if (canEdit && errors.length) { %>
  <div class="form-message form-error" role="alert">
    <h2>Items to complete before DSA submission</h2>
    <ul>
      <% errors.forEach(function(e) { %>
        <li><%= e %></li>
      <% }); %>
    </ul>
  </div>
<% } else if (canEdit) { %>
  <div class="form-message" role="status">
    Required details are complete for preview.
    Review supporting documents before submission.
  </div>
<% } %>

<section class="surface-card section-block"><h2>Trip overview</h2><dl class="proposal-details"><dt>Destination</dt><dd><%= destination?.name||'Unavailable' %></dd><dt>Purpose</dt><dd><%= trip.purpose||'Not provided' %></dd><dt>Description</dt><dd><%= trip.description||'Not provided' %></dd><dt>Dates</dt><dd><%= values.start_date %> to <%= values.end_date %></dd><dt>Meeting</dt><dd><%= trip.meeting_point||'Not provided' %> at <%= values.meeting_time||'Not provided' %></dd><dt>Transport</dt><dd><%= trip.transport_information||'Not provided' %></dd><dt>Participant limit</dt><dd><%= trip.max_participants %></dd><dt>Registration deadline</dt><dd><%= values.registration_deadline||'Not provided' %></dd><dt>Estimated cost per student</dt><dd>Nu. <%= Number(trip.estimated_cost).toFixed(2) %></dd><dt>Budget note</dt><dd><%= trip.estimated_budget_note||'None' %></dd><dt>Safety information</dt><dd><%= trip.safety_information||'Not provided' %></dd><dt>Emergency contact</dt><dd><%= trip.emergency_contact_name||'Not provided' %> · <%= trip.emergency_contact_phone||'Not provided' %></dd></dl></section>
<section class="surface-card section-block"><h2>Estimated costs</h2><% if(!costs.length){%><p>No cost items entered.</p><%}else{%><ul><% costs.forEach(function(c){%><li><%= c.label %>: Nu. <%= Number(c.amount).toFixed(2) %></li><%});%></ul><%}%></section>
<section class="surface-card section-block"><h2>Itinerary</h2><% if(!itinerary.length){%><p>No itinerary activities entered.</p><%}else{%><ol><%itinerary.forEach(function(row){%><li><strong>Day <%= row.day_number %> — <%= row.title %></strong> (<%= row.start_time||'Time not provided' %>) <p><%= row.description||'' %></p></li><%});%></ol><%}%></section>
<% if(canEdit){%><a class="btn btn-secondary" href="/workspace/proposals/<%= trip.id %>/attachments">Manage supporting documents</a> <form method="post" action="/workspace/proposals/<%= trip.id %>/submit" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit" <%= errors.length?'disabled':'' %>>Submit to DSA</button></form> <a class="btn btn-primary" href="/workspace/proposals/<%= trip.id %>/edit">Edit draft</a><%}%> <a class="text-link" href="/workspace/proposals">All my proposals →</a>
<%- include('../partials/footer') %>
