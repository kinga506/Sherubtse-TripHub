<%- include('../partials/header') %>
<div class="page-heading"><p class="eyebrow">Student workspace</p><h1>My Trip Proposals</h1><p class="lead">Only you and authorised reviewers can see your private proposals.</p><a class="btn btn-primary" href="/workspace/proposals/new">Organise a Trip</a></div>
<section class="section-block"><% if(!proposals.length){%><div class="empty-state"><h2>No proposals yet</h2><p>Start a draft to plan your first student trip.</p></div><%}else{%><div class="feature-grid"><% proposals.forEach(function(p){%><article class="feature-card"><span class="status-badge badge-neutral"><%= p.approval_status.replaceAll('_',' ') %></span><h2><%= p.title %></h2><p><%= p.destination %> · <%= new Date(p.start_date).toISOString().slice(0,10) %></p><a class="text-link" href="/workspace/proposals/<%= p.id %>/preview">Preview</a><% if(['draft','changes_requested'].includes(p.approval_status)){%><p><a href="/workspace/proposals/<%= p.id %>/edit">Continue editing →</a></p><%}%></article><%});%></div><%}%></section>
<%- include('../partials/footer') %>
