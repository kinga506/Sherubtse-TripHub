<%- include('../partials/header') %><section class="admin-page"><p><a href="/workspace/superadmin/trips">← Trip Monitoring</a></p><header class="admin-page-heading"><div><p class="eyebrow">Read-only trip progress</p><h1><%= trip.title %></h1><p><%= trip.destination %> · Proposed by <%= trip.proposer %></p></div></header><dl class="admin-detail-list"><div><dt>Approval status</dt><dd><%= ({pending_dsa:'Pending DSA Review',approved:'Approved',rejected:'Rejected',changes_requested:'Changes Requested'})[trip.approval_status]||trip.approval_status %></dd></div><div><dt>Operational status</dt><dd><%= ({planned:'Upcoming',ongoing:'Ongoing',completed:'Completed',cancelled:'Cancelled',awaiting_final_report:'Awaiting Final Report'})[trip.operational_status]||trip.operational_status %></dd></div><div><dt>Trip dates</dt><dd><%= String(trip.start_date).slice(0,10) %> – <%= String(trip.end_date).slice(0,10) %></dd></div><div><dt>Current participants</dt><dd><%= trip.participants %></dd></div><div><dt>Coordinator assignments</dt><dd><%= trip.coordinators %></dd></div><div><dt>Final namelist review</dt><dd><%= trip.final_status||'Not submitted' %></dd></div><div><dt>Registration</dt><dd><%= trip.registration_open?'Open':'Closed' %></dd></div><div><dt>Proposal created</dt><dd><%= new Date(trip.created_at).toLocaleString() %></dd></div></dl><section class="admin-panel"><p>Trip decisions and coordinator assignments remain under DSA control. Superadmin monitoring is read-only.</p></section></section><%- include('../partials/footer') %>
