<%- include('../partials/header') %>
<section class="admin-page">
<header class="admin-page-heading"><div><p class="eyebrow">Read only</p><h1>Trip Monitoring</h1><p>DSA retains authority over approvals and coordinator assignments.</p></div></header>
<form class="admin-filter-form"><label>Search<input name="q" value="<%= query.q||'' %>" placeholder="Trip, destination or proposer"></label><label>Approval status<select name="status"><option value="">All statuses</option><% [['pending_dsa','Pending DSA Review'],['approved','Approved'],['rejected','Rejected'],['changes_requested','Changes Requested']].forEach(s=>{ %><option value="<%= s[0] %>" <%= query.status===s[0]?'selected':'' %>><%= s[1] %></option><% }) %></select></label><button class="btn">Filter</button></form>
<div class="admin-panel admin-table-wrap"><table class="admin-table"><thead><tr><th>Trip</th><th>Destination</th><th>Proposer</th><th>Approval</th><th>Operational</th><th>Dates</th><th>Lead Coordinator</th><th>Participants</th><th>Final namelist</th></tr></thead><tbody><% trips.forEach(t=>{ %><tr><td><a href="/workspace/superadmin/trips/<%= t.id %>"><%= t.title %></a></td><td><%= t.destination %></td><td><%= t.proposer %></td><td><%= ({pending_dsa:'Pending DSA Review',approved:'Approved',rejected:'Rejected',changes_requested:'Changes Requested'})[t.approval_status]||t.approval_status %></td><td><%= ({planned:'Upcoming',ongoing:'Ongoing',completed:'Completed',cancelled:'Cancelled',awaiting_final_report:'Awaiting Final Report'})[t.operational_status]||t.operational_status %></td><td><%= String(t.start_date).slice(0,10) %> – <%= String(t.end_date).slice(0,10) %></td><td><%= t.coordinator||'Unassigned' %></td><td><%= t.participants %></td><td><%= ({pending:'Pending review',approved:'Approved',rejected:'Rejected'})[t.final_status]||t.final_status||'Not submitted' %></td></tr><% }) %></tbody></table><% if(!trips.length){ %><p class="admin-empty">No matching trip records.</p><% } %></div></section>
<%- include('../partials/footer') %>
