<%- include('../partials/header') %>
<section class="admin-page">
  <p><a href="/workspace/superadmin/manage/users">← User Management</a></p>
  <header class="admin-page-heading"><div><p class="eyebrow">Superadmin workspace</p><h1>DSA Transition Management</h1><p>Manage DSA appointments while preserving all institutional history.</p></div></header>
  <% if(errorMessage){ %><p class="admin-notice" role="alert"><%= errorMessage %></p><% } %>
  <% if(notice==='awaiting-activation'){ %><p class="admin-notice" role="status">Awaiting incoming DSA account activation. The transition will remain pending until the invitee activates their account.</p><% } %>
  <% if(notice==='transition-completed'){ %><p class="admin-notice" role="status">DSA transition completed. The former DSA’s access and sessions have been revoked.</p><% } %>
  <% if(notice==='emergency-revoked'){ %><p class="admin-notice" role="status">Emergency DSA access revocation completed. Historical records remain unchanged.</p><% } %>
  <% if(notice==='emergency-last-dsa'){ %><p class="admin-notice" role="alert"><strong>Emergency revocation completed.</strong> No active, verified DSA account remains. DSA reviews are temporarily unavailable until a DSA account is activated.</p><% } %>
  <section class="admin-panel"><h2>Review workload</h2><p><strong><%= pendingReviews.proposals %></strong> trip proposals and <strong><%= pendingReviews.final_namelists %></strong> final participant lists are awaiting DSA review. Pending reviews are available to any active, verified DSA account.</p></section>
  <form class="admin-filter-form" method="get" action="/workspace/superadmin/dsa-transitions"><label>Search DSA accounts and transition history<input name="q" value="<%= search %>" placeholder="Name or email"></label><button class="btn" type="submit">Search</button></form>

  <section class="admin-panel" aria-labelledby="active-dsa-heading"><h2 id="active-dsa-heading">Active DSA Accounts</h2>
    <% if(!active.length){ %><p class="admin-empty">No active, verified DSA accounts match this search.</p><% }else{ %>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Account status</th><th>Appointment date recorded</th></tr></thead><tbody><% active.forEach(account=>{ %><tr><td><%= account.name %></td><td><%= account.email %></td><td><span class="status-badge badge-success">Active and verified</span></td><td>Not recorded</td></tr><% }) %></tbody></table></div><% } %>
  </section>

  <details class="admin-create-panel"><summary class="btn btn-primary">Manage Transition</summary>
    <form class="admin-form-grid" method="post" action="/workspace/superadmin/dsa-transitions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Outgoing DSA<select name="outgoingDsaId" required><option value="">Select current DSA</option><% active.forEach(account=>{ %><option value="<%= account.id %>"><%= account.name %> — <%= account.email %></option><% }) %></select></label>
      <label>Incoming DSA<select name="incomingDsaId" required><option value="">Select incoming DSA</option><% active.forEach(account=>{ %><option value="<%= account.id %>"><%= account.name %> — <%= account.email %> (active)</option><% }) %><% pending.forEach(account=>{ %><option value="<%= account.id %>"><%= account.name %> — <%= account.email %> (<%= account.invitation_status %>)</option><% }) %></select></label>
      <label>Reason for transition<select name="reason" required><option value="">Select a reason</option><% reasons.forEach(reason=>{ %><option value="<%= reason %>"><%= reason %></option><% }) %></select></label>
      <label>Effective date<input type="date" name="effectiveDate" required><small>This records the requested date. Future dates are not supported; access changes take effect when you complete the transition.</small></label>
      <label>Appointment reference (optional)<input name="appointmentReference" maxlength="200" autocomplete="off"></label>
      <button class="btn btn-primary" type="submit">Review Transition</button>
      <p class="small-muted">New DSA staff must first be invited through <a href="/workspace/superadmin/manage/users">User Management</a>. Pending invitees appear here and must activate before transition completion.</p>
    </form>
  </details>

  <section class="admin-panel"><h2>Pending DSA Invitations</h2><% if(!pending.length){ %><p class="admin-empty">No pending DSA invitations match this search.</p><% }else{ %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Invitation status</th><th>Account status</th><th>Action</th></tr></thead><tbody><% pending.forEach(account=>{ %><tr><td><%= account.name %></td><td><%= account.email %></td><td><span class="status-badge badge-warning"><%= account.invitation_status %></span></td><td><%= account.is_active?'Enabled until activation':'Inactive' %></td><td><a href="/workspace/superadmin/users/<%= account.id %>">View or resend invitation</a></td></tr><% }) %></tbody></table></div><% } %></section>

  <section class="admin-panel"><h2>Former / Suspended DSA</h2><% if(!former.length){ %><p class="admin-empty">No former or suspended DSA accounts match this search.</p><% }else{ %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Account status</th><th>Registered</th></tr></thead><tbody><% former.forEach(account=>{ %><tr><td><%= account.name %></td><td><%= account.email %></td><td><span class="status-badge badge-neutral">Suspended</span></td><td><%= new Date(account.created_at).toLocaleDateString() %></td></tr><% }) %></tbody></table></div><% } %></section>

  <section class="admin-panel"><h2>Emergency Revoke Access</h2><p><strong>This immediately suspends the selected DSA account and removes its sessions.</strong> It does not appoint a replacement or decide any pending reviews. If no other verified DSA remains, DSA reviews will be temporarily unavailable.</p>
    <% if(!active.length){ %><p class="admin-empty">There are no active DSA accounts available to revoke.</p><% }else{ %><div class="admin-record-grid"><% active.forEach(account=>{ %><form method="post" class="admin-panel" action="/workspace/superadmin/dsa-transitions/emergency-revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dsaId" value="<%= account.id %>"><h3><%= account.name %></h3><p><%= account.email %></p><label>Reason (required)<textarea name="reason" minlength="8" maxlength="500" required></textarea></label><label>Type REVOKE to confirm<input name="confirmation" autocomplete="off" required pattern="REVOKE"></label><button class="btn btn-outline" type="submit">Emergency Revoke Access</button></form><% }) %></div><% } %>
  </section>

  <section class="admin-panel"><h2>Transition History</h2><% if(!transitions.length){ %><p class="admin-empty">No DSA transitions have been recorded.</p><% }else{ %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Outgoing DSA</th><th>Incoming DSA</th><th>Reason</th><th>Effective / completed</th><th>Superadmin</th><th>Status</th><th>Action</th></tr></thead><tbody><% transitions.forEach(item=>{ %><tr><td><%= item.outgoing_name %><br><small><%= item.outgoing_email %></small></td><td><%= item.incoming_name||'No replacement (emergency)' %><% if(item.incoming_email){ %><br><small><%= item.incoming_email %></small><% } %></td><td><%= item.reason %><% if(item.appointment_reference){ %><br><small>Reference: <%= item.appointment_reference %></small><% } %></td><td><%= item.completed_at?new Date(item.completed_at).toLocaleString():String(item.effective_date).slice(0,10) %></td><td><%= item.actor_name %></td><td><span class="status-badge <%= ['completed','emergency_revoked'].includes(item.status)?'badge-success':item.status==='cancelled'?'badge-neutral':'badge-warning' %>"><%= ({awaiting_activation:'Awaiting activation',ready_to_complete:'Ready to complete',completed:'Completed',emergency_revoked:'Emergency revoked',cancelled:'Cancelled'})[item.status] %></span></td><td><% if(item.status==='ready_to_complete'&&item.incoming_active&&item.incoming_verified){ %><a href="/workspace/superadmin/dsa-transitions/<%= item.id %>/review">Review and complete</a><% }else if(item.status==='awaiting_activation'){ %>Awaiting incoming DSA account activation<% }else{ %>—<% } %></td></tr><% }) %></tbody></table></div><% } %></section>
</section><%- include('../partials/footer') %>
