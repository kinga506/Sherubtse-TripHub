<%- include('../partials/header') %><section class="admin-page"><header class="admin-page-heading"><div><p class="eyebrow">Append-only activity</p><h1>Audit Logs</h1><p>Recent sensitive administrative actions</p></div></header><form class="admin-filter-form"><label>Search activity<input name="q" value="<%= req.query.q||'' %>" placeholder="Actor, action or record type"></label><button class="btn">Search</button></form><div class="admin-panel admin-table-wrap"><table class="admin-table"><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th></tr></thead><tbody><% logs.forEach(a=>{ %><tr><td><%= new Date(a.created_at).toLocaleString() %></td><td><%= a.actor||'Unknown account' %></td><td><%= a.action.replaceAll('_',' ') %></td><td><%= a.target_type %> #<%= a.target_id %></td></tr><% }) %></tbody></table><% if(!logs.length){ %><p class="admin-empty">No audit records yet.</p><% } %></div></section><%- include('../partials/footer') %>
