
<%- include('../partials/header') %>

<div class="admin-page">

  <div class="admin-hero">
    <p class="eyebrow">Platform Administration</p>
    <h1>Superadmin Dashboard</h1>
    <p class="lead">
      Manage accounts and public content for Sherubtse TripHub.
      Only DSA can approve trips and assign Coordinators.
    </p>
  </div>

  <!-- ACCOUNT STATISTICS -->
  <section class="admin-section">
    <div class="admin-section-heading">
      <div>
        <p class="eyebrow">Overview</p>
        <h2>Platform at a Glance</h2>
      </div>

      <a class="btn btn-primary"
         href="/workspace/superadmin/manage/users">
        Manage Users
      </a>
    </div>

    <div class="admin-stats">

      <article class="admin-stat">
        <span class="admin-stat-label">Total Accounts</span>
        <strong class="admin-stat-number">
          <%= users.total %>
        </strong>
        <span class="admin-stat-note">
          Registered platform accounts
        </span>
      </article>

      <article class="admin-stat">
        <span class="admin-stat-label">Student Accounts</span>
        <strong class="admin-stat-number">
          <%= users.students %>
        </strong>
        <span class="admin-stat-note">
          Students and trip proposers
        </span>
      </article>

      <article class="admin-stat">
        <span class="admin-stat-label">DSA Accounts</span>
        <strong class="admin-stat-number">
          <%= users.dsa %>
        </strong>
        <span class="admin-stat-note">
          Authorised trip reviewers
        </span>
      </article>

    </div>

    <% if (users.dsa === 0) { %>
      <div class="admin-notice">
        <div>
          <strong>No DSA account yet</strong>
          <p>
            Create a DSA account to review pending trip proposals.
          </p>
        </div>

        <a class="btn btn-primary"
           href="/workspace/superadmin/manage/users">
          Create DSA Account
        </a>
      </div>
    <% } %>
  </section>

  <!-- MANAGEMENT LINKS -->
  <section class="admin-section">
    <div class="admin-section-heading">
      <div>
        <p class="eyebrow">Administration</p>
        <h2>Manage Platform Data</h2>
      </div>
    </div>

    <div class="admin-actions">
      <%
        const links = [
          {
            section: 'users',
            label: 'Manage Users',
            desc: 'Manage accounts and provision DSA reviewers',
            icon: '👥'
          },
          {
            section: 'programmes',
            label: 'Programmes',
            desc: 'Manage academic programmes',
            icon: '🎓'
          },
          {
            section: 'destinations',
            label: 'Destinations',
            desc: 'Maintain destination information',
            icon: '📍'
          },
          {
            section: 'photos',
            label: 'Destination Photos',
            desc: 'Upload and manage destination photographs',
            icon: '🖼️'
          },
          {
            section: 'faqs',
            label: 'FAQs',
            desc: 'Manage frequently asked questions',
            icon: '❔'
          },
          {
            section: 'trip_rules',
            label: 'Trip Rules',
            desc: 'Maintain trip guidance and regulations',
            icon: '📋'
          },
          {
            section: 'testimonials',
            label: 'Testimonials',
            desc: 'Manage public testimonials',
            icon: '💬'
          }
        ];
      %>

      <% links.forEach(function(link) { %>

        <a class="admin-action"
           href="/workspace/superadmin/manage/<%= link.section %>">

          <span class="admin-action-icon">
            <%= link.icon %>
          </span>

          <span class="admin-action-body">
            <strong><%= link.label %></strong>
            <small><%= link.desc %></small>
          </span>

          <span class="admin-action-arrow">→</span>
        </a>

      <% }); %>
    </div>
  </section>

  <!-- TRIP STATUS -->
  <section class="admin-section">
    <div class="admin-section-heading">
      <div>
        <p class="eyebrow">Trip Monitoring</p>
        <h2>Trip Status Overview</h2>
      </div>
    </div>

    <div class="admin-panel">

      <% if (!tripStats.length) { %>
        <p class="admin-empty">No trip records yet.</p>
      <% } else { %>

        <div class="admin-status-grid">

          <% tripStats.forEach(function(t) { %>
            <div class="admin-status-item">

              <span class="admin-status-count">
                <%= t.count %>
              </span>

              <div>
                <strong>
                  <%= String(t.approval_status).replaceAll('_', ' ') %>
                </strong>

                <small>
                  Operational:
                  <%= String(t.operational_status).replaceAll('_', ' ') %>
                </small>
              </div>

            </div>
          <% }); %>

        </div>
      <% } %>

    </div>
  </section>

  <!-- COORDINATORS -->
  <section class="admin-section">

    <div class="admin-section-heading">
      <div>
        <p class="eyebrow">Read-only</p>
        <h2>Coordinator Assignments</h2>
        <p>
          Only DSA can create, end or reassign Coordinators.
        </p>
      </div>
    </div>

    <div class="admin-panel admin-table-wrap">

      <% if (!assignments.length) { %>

        <p class="admin-empty">
          No Coordinator assignments to display.
        </p>

      <% } else { %>

        <table class="admin-table">
          <thead>
            <tr>
              <th>Trip</th>
              <th>Student</th>
              <th>Assignment</th>
              <th>Status</th>
              <th>Assigned By</th>
            </tr>
          </thead>

          <tbody>
            <% assignments.forEach(function(a) { %>
              <tr>
                <td><%= a.title %></td>
                <td><%= a.student_name %></td>
                <td><%= a.assignment_role %></td>
                <td><%= a.status %></td>
                <td><%= a.assigned_by_name %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>

      <% } %>

    </div>
  </section>

</div>

<%- include('../partials/footer') %>
