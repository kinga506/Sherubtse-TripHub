<%- include('../partials/header') %>
<div class="admin-page">
<header class="admin-page-heading"><div><p class="eyebrow">Superadmin workspace</p><h1>Overview</h1><p>Monitor and manage Sherubtse TripHub</p></div><span><%= currentUser.name %></span></header>
<section class="admin-section"><div class="admin-stats">
<article class="admin-stat"><span class="admin-stat-label">Total Registered Users</span><strong class="admin-stat-number"><%= users.total %></strong></article>
<article class="admin-stat"><span class="admin-stat-label">Active DSA Accounts</span><strong class="admin-stat-number"><%= users.dsa_active %></strong><span class="admin-stat-note"><%= users.dsa_total %> total DSA accounts</span></article>
<article class="admin-stat"><span class="admin-stat-label">Pending DSA Reviews</span><strong class="admin-stat-number"><%= reviewCount %></strong></article>
<article class="admin-stat"><span class="admin-stat-label">Upcoming Approved Trips</span><strong class="admin-stat-number"><%= upcomingTrips %></strong></article>
</div></section>
<% if(users.dsa_active===0){ %><section class="admin-notice"><div><strong>No active DSA account exists</strong><p>Pending proposals cannot be reviewed until a verified, active DSA account is available.</p></div><a class="btn btn-primary" href="/workspace/superadmin/manage/users">Create DSA Account</a></section><% } %>
<section class="admin-section"><div class="admin-section-heading"><div><p class="eyebrow">Platform content</p><h2>Content Management</h2></div></div><div class="admin-actions"><a class="admin-action" href="/workspace/superadmin/manage/destinations"><span class="admin-action-body"><strong>Destinations & Photos</strong><small>Manage destinations, guides and associated images</small></span></a><a class="admin-action" href="/workspace/superadmin/manage/programmes"><span class="admin-action-body"><strong>Academic Programmes</strong><small>Maintain programme references</small></span></a><a class="admin-action" href="/workspace/superadmin/manage/faqs"><span class="admin-action-body"><strong>Help & FAQs</strong><small>Edit public answers and publication status</small></span></a><a class="admin-action" href="/workspace/superadmin/manage/trip_rules"><span class="admin-action-body"><strong>Trip Guidelines & Policies</strong><small>Maintain published guidance</small></span></a></div></section>
<section class="admin-section"><div class="admin-section-heading"><div><p class="eyebrow">Trip Monitoring</p><h2>Trip Status</h2></div><a href="/workspace/superadmin/trips">View all trips</a></div><div class="admin-panel"><% if(!tripStats.length){ %><p class="admin-empty">No trip records yet.</p><% }else{ %><div class="admin-status-grid"><% tripStats.forEach(t=>{ %><div class="admin-status-item"><span class="admin-status-count"><%= t.count %></span><div><strong><%= ({pending_dsa:'Pending DSA Review',approved:'Approved',rejected:'Rejected',changes_requested:'Changes Requested',draft:'Draft'})[t.approval_status]||t.approval_status %></strong><small><%= ({planned:'Upcoming',ongoing:'Ongoing',completed:'Completed',cancelled:'Cancelled',awaiting_final_report:'Awaiting Final Report'})[t.operational_status]||t.operational_status %></small></div></div><% }) %></div><% } %></div></section>
<section class="admin-section"><div class="admin-section-heading"><div><p class="eyebrow">Recent Activity</p><h2>Administrative Activity</h2></div><a href="/workspace/superadmin/audit">View audit logs</a></div><div class="admin-panel"><% if(!recentAudit.length){ %><p class="admin-empty">No administrative activity has been recorded yet.</p><% }else{ %><ul class="admin-activity-list"><% recentAudit.forEach(a=>{ %><li><span><strong><%= a.action.replaceAll('_',' ') %></strong> · <%= a.target_type %> #<%= a.target_id %></span><small><%= a.actor||'System' %> · <%= new Date(a.created_at).toLocaleString() %></small></li><% }) %></ul><% } %></div></section>
</div>
<%- include('../partials/footer') %>
