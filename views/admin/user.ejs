<%- include('../partials/header') %><section class="admin-page"><p><a href="/workspace/superadmin/manage/users">← User Management</a></p><header class="admin-page-heading"><div><p class="eyebrow">Account details</p><h1><%= user.name %></h1><p><%= user.email %></p></div><span class="status-badge <%= user.is_active?'badge-success':'badge-neutral' %>"><%= user.is_active?'Active':'Suspended' %></span></header><dl class="admin-detail-list"><div><dt>Role</dt><dd><%= ({student:'Student',dsa:'DSA',admin:'Superadmin'})[user.role] %></dd></div><div><dt>Verification</dt><dd><%= user.is_verified?'Verified':'Unverified' %></dd></div><div><dt>Student ID</dt><dd><%= user.student_id||'—' %></dd></div><div><dt>Academic programme</dt><dd><%= user.programme||'—' %></dd></div><div><dt>Registered</dt><dd><%= new Date(user.created_at).toLocaleString() %></dd></div></dl><section class="admin-panel"><h2>Account actions</h2><p>Suspending an account prevents future authenticated requests. Existing sessions are checked against account status on every request.</p><form method="post" data-admin-confirm="<%= user.is_active?'This account will lose access on its next request.':'This account will regain access on its next request.' %>" data-admin-confirm-title="<%= user.is_active?'Suspend account':'Reactivate account' %>" action="/workspace/superadmin/manage/users/<%= user.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="is_active" value="<%= user.is_active?'false':'true' %>"><button class="btn" <%= Number(user.id)===Number(currentUser.id)?'disabled':'' %>><%= user.is_active?'Suspend account':'Reactivate account' %></button></form><% if(user.role==='dsa'&&!user.is_verified){ %><form method="post" action="/workspace/superadmin/users/<%= user.id %>/resend-invitation"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Resend activation invitation</button></form><% } %><p><a href="/auth/forgot-password">Initiate password reset</a> (account holder completes the existing secure email flow).</p></section></section><%- include('../partials/footer') %>
