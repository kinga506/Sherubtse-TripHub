<%- include('../partials/header') %>
<section class="section"><p><a href="/workspace/superadmin">← Superadmin</a></p><h1>Manage <%= section.replaceAll('_',' ') %></h1><p>Only verified Superadmins can change platform content. This page cannot approve trips or grant Coordinator assignments.</p>
<% if(section==='users'){ %><h2>Provision a DSA account</h2><form method="post" action="/workspace/superadmin/create-dsa" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name <input name="name" maxlength="100" required></label><label>Email <input name="email" type="email" required></label><label>Initial password <input name="password" type="password" minlength="12" maxlength="72" required></label><button class="btn" type="submit">Create DSA account</button></form><% } %>
<% if(section==='destinations'){ %><h2>Add a destination</h2><form method="post" class="card" action="/workspace/superadmin/destinations/new"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name <input required name="name"></label><label>URL slug <input required name="slug" placeholder="example-destination"></label><label>Dzongkhag <input required name="dzongkhag"></label><label>Description <textarea required name="description"></textarea></label><button class="btn" type="submit">Add destination</button></form><% } %>
<% if(section==='photos'){ %><h2>Upload a destination photograph</h2><form method="post" enctype="multipart/form-data" action="/workspace/superadmin/photos/new" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Destination ID <input required type="number" min="1" name="destination_id"></label><label>PNG or JPEG (max 8 MB) <input required type="file" accept="image/png,image/jpeg" name="photo"></label><label>Alternative text <input required name="alt_text"></label><label>Photographer / credit <input name="photo_credit"></label><button class="btn" type="submit">Upload photo</button></form><% } %>
<% if(['programmes' ,'faqs','trip_rules','testimonials'].includes(section)){ %>
<h2>Add record</h2><form class="card" method="post" action="/workspace/superadmin/manage/<%= section %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% (section==='programmes'?['code','name']:section==='faqs'?['question','answer']:section==='trip_rules'?['title','body']:['title','quote','attribution']).forEach(field=>{ %><label><%= field %><input name="<%= field %>" maxlength="2000" <%= field==='attribution'?'':'required' %>></label><% }) %><button class="btn" type="submit">Add</button></form><% } %>
<h2>Existing records</h2>
<% if(!rows.length){ %><p>No records found.</p><% } %>
<% rows.forEach(item=>{ const keys=section==='users'?['name','email','role','is_verified','is_active']:section==='programmes'?['code','name','is_active']:section==='destinations'?['name','dzongkhag','description','best_season','transport','entry_fee_note','practical_tip','is_active']:section==='photos'?['alt_text','photo_credit','sort_order']:section==='faqs'?['question','answer','sort_order','is_active']:section==='trip_rules'?['title','body','sort_order','is_active']:['title','quote','attribution','sort_order','is_active']; %>
<form method="post" class="card" style="margin-bottom:16px" action="/workspace/superadmin/manage/<%= section %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Record #<%= item.id %> <% if(item.destination){ %>— <%= item.destination %><% } %></h3>
<% keys.forEach(key=>{const readonly=section==='users'&&key!=='is_active'; %><label style="display:block;margin:8px 0"><strong><%= key.replaceAll('_',' ') %></strong>
<% if(key==='is_active'){ %><select name="is_active"><option value="true" <%= item.is_active?'selected':'' %>>Active</option><option value="false" <%= !item.is_active?'selected':'' %>>Inactive</option></select>
<% }else if(readonly){ %><span> <%= String(item[key]??'—') %></span>
<% }else if(['description','answer','body','quote'].includes(key)){ %><textarea name="<%= key %>" rows="3" maxlength="7000"><%= item[key]??'' %></textarea>
<% }else{ %><input name="<%= key %>" value="<%= item[key]??'' %>" maxlength="1000" <%= key==='sort_order'?'type=number min=0 max=9999':'' %>><% } %></label><% }) %><button class="btn" type="submit">Save changes</button></form><% }) %>
</section><%- include('../partials/footer') %>
