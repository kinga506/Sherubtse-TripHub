<%- include('../partials/header') %><section class="admin-page"><header class="admin-page-heading"><div><p class="eyebrow">Superadmin workspace</p><h1><%= section==='users'?'User Management':section==='trip_rules'?'Trip Guidelines & Policies':section.replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase()) %></h1><p><% if(userPage){ %><%= userPage.total %> accounts match the current filters<% }else{ %>Manage current platform records<% } %></p></div></header>
<% if(section==='users'){ %>
<% if(req.query.invitation==='delivery-failed'){ %><p class="admin-notice" role="status">Invitation email could not be delivered. This account is inactive; open its details to resend the invitation.</p><% } %><details class="admin-create-panel"><summary class="btn btn-primary">Create DSA Account</summary><form method="post" action="/workspace/superadmin/create-dsa" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name<input name="name" maxlength="100" autocomplete="name" required></label><label>Email<input name="email" type="email" maxlength="254" autocomplete="email" required></label><button class="btn btn-primary" type="submit">Send activation invitation</button><p class="small-muted">The DSA member uses the secure invitation link to create a password and activate the account. The link expires after one hour.</p></form></details>
<form class="admin-filter-form" method="get"><label>Search<input name="q" value="<%= userPage.filters.q %>" placeholder="Name or email"></label><label>Role<select name="role"><option value="">All roles</option><option value="student" <%= userPage.filters.role==='student'?'selected':'' %>>Student</option><option value="dsa" <%= userPage.filters.role==='dsa'?'selected':'' %>>DSA</option><option value="admin" <%= userPage.filters.role==='admin'?'selected':'' %>>Superadmin</option></select></label><label>Verification<select name="verified"><option value="">All</option><option value="true" <%= userPage.filters.verified==='true'?'selected':'' %>>Verified</option><option value="false" <%= userPage.filters.verified==='false'?'selected':'' %>>Unverified</option></select></label><label>Account status<select name="active"><option value="">All</option><option value="true" <%= userPage.filters.active==='true'?'selected':'' %>>Active</option><option value="false" <%= userPage.filters.active==='false'?'selected':'' %>>Suspended</option></select></label><button class="btn" type="submit">Filter</button></form>
<div class="admin-panel admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Verification</th><th>Invitation</th><th>Account Status</th><th>Registration Date</th><th>Actions</th></tr></thead><tbody><% rows.forEach(item=>{ %><tr><td><%= item.name %></td><td><%= item.email %></td><td><%= ({student:'Student',dsa:'DSA',admin:'Superadmin'})[item.role] %></td><td><%= item.is_verified?'Verified':'Unverified' %></td><td><%= item.invitation_status||'—' %></td><td><%= item.is_active?'Active':'Suspended' %></td><td><%= new Date(item.created_at).toLocaleDateString() %></td><td><a href="/workspace/superadmin/users/<%= item.id %>">View</a> · <form class="inline-form" method="post" data-admin-confirm="<%= item.is_active?'This account will lose access on its next request.':'This account will regain access on its next request.' %>" data-admin-confirm-title="<%= item.is_active?'Suspend account':'Reactivate account' %>" action="/workspace/superadmin/manage/users/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="is_active" value="<%= item.is_active?'false':'true' %>"><button class="text-button" <%= Number(item.id)===Number(currentUser.id)?'disabled title="You cannot suspend your own account"':'' %>><%= item.is_active?'Suspend':'Reactivate' %></button></form></td></tr><% }) %></tbody></table><% if(!rows.length){ %><p class="admin-empty">No accounts match these filters.</p><% } %></div>
<nav class="admin-pagination" aria-label="User pages"><% if(userPage.page>1){ %><a href="?q=<%= encodeURIComponent(userPage.filters.q) %>&role=<%= userPage.filters.role %>&verified=<%= userPage.filters.verified %>&active=<%= userPage.filters.active %>&page=<%= userPage.page-1 %>">Previous</a><% } %><span>Page <%= userPage.page %> of <%= userPage.pages %></span><% if(userPage.page<userPage.pages){ %><a href="?q=<%= encodeURIComponent(userPage.filters.q) %>&role=<%= userPage.filters.role %>&verified=<%= userPage.filters.verified %>&active=<%= userPage.filters.active %>&page=<%= userPage.page+1 %>">Next</a><% } %></nav>
<% }else{ %>
<% if(section==='destinations'){ %><h2>Add a destination</h2><form method="post" class="admin-panel admin-form-grid" action="/workspace/superadmin/destinations/new"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input required name="name"></label><label>URL slug<input required name="slug"></label><label>Dzongkhag<input required name="dzongkhag"></label><label>Description<textarea required name="description"></textarea></label><button class="btn" type="submit">Add destination</button></form><% } %>
<% if(section==='photos'){ %><h2>Upload a destination photograph</h2><form method="post" enctype="multipart/form-data" action="/workspace/superadmin/photos/new" class="admin-panel admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Destination<select required name="destination_id"><option value="">Select destination</option><% destinations.forEach(d=>{ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></label><label>PNG or JPEG (max 8 MB)<input required type="file" accept="image/png,image/jpeg" name="photo"></label><label>Alternative text<input required name="alt_text"></label><label>Photographer / credit<input name="photo_credit"></label><button class="btn" type="submit">Upload photo</button></form><% } %>
<% if(['programmes','faqs','trip_rules','testimonials'].includes(section)){ %><h2>Add record</h2><form class="admin-panel admin-form-grid" method="post" action="/workspace/superadmin/manage/<%= section %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% (section==='programmes'?['code','name']:section==='faqs'?['question','answer']:section==='trip_rules'?['title','body']:['title','quote','attribution']).forEach(field=>{ %><label><%= field.replaceAll('_',' ') %><% if(['answer','body','quote'].includes(field)){ %><textarea name="<%= field %>" required></textarea><% }else{ %><input name="<%= field %>" maxlength="1000" <%= field==='attribution'?'':'required' %>><% } %></label><% }) %><button class="btn" type="submit">Add record</button></form><% } %>
<h2>Existing records</h2><% if(!rows.length){ %><p class="admin-empty">No records found.</p><% } %><div class="admin-record-grid"><% rows.forEach(item=>{ const keys=section==='programmes'?['code','name','is_active']:section==='destinations'?['name','dzongkhag','description','best_season','transport','entry_fee_note','practical_tip','is_active']:section==='photos'?['alt_text','photo_credit','sort_order']:section==='faqs'?['question','answer','sort_order','is_active']:section==='trip_rules'?['title','body','sort_order','is_active']:['title','quote','attribution','sort_order','is_active']; %><form method="post" class="admin-panel" action="/workspace/superadmin/manage/<%= section %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3><%= item.name||item.title||item.question||('Photo #'+item.id) %><% if(item.destination){ %> · <%= item.destination %><% } %></h3><% if(section==='photos'){ %><img class="admin-photo-preview" src="/managed-photos/<%= item.id %>" alt="<%= item.alt_text %>"><% } %><% keys.forEach(key=>{ %><label><%= key.replaceAll('_',' ') %><% if(key==='is_active'){ %><select name="is_active"><option value="true" <%= item.is_active?'selected':'' %>>Published / Active</option><option value="false" <%= !item.is_active?'selected':'' %>>Unpublished / Inactive</option></select><% }else if(['description','answer','body','quote'].includes(key)){ %><textarea name="<%= key %>" rows="3"><%= item[key]??'' %></textarea><% }else{ %><input name="<%= key %>" value="<%= item[key]??'' %>" <%= key==='sort_order'?'type=number min=0 max=9999':'' %>><% } %></label><% }) %><button class="btn" type="submit">Save changes</button></form><% }) %></div>
<% } %></section><%- include('../partials/footer') %>
