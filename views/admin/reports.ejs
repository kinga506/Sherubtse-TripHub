<%- include('../partials/header') %><section class="admin-page"><header class="admin-page-heading"><div><p class="eyebrow">Database summaries</p><h1>Reports</h1><p>Counts are calculated from current platform records.</p></div><a class="btn" href="/workspace/superadmin/reports.csv">Export CSV</a></header><% const groups={};rows.forEach(r=>{(groups[r.group_name]??=[]).push(r)});Object.entries(groups).forEach(([group,items])=>{ %><section class="admin-section"><h2><%= group %></h2><div class="admin-panel admin-table-wrap"><table class="admin-table"><thead><tr><th>Category</th><th>Count</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.label %></td><td><%= i.value %></td></tr><% }) %></tbody></table></div></section><% }) %></section><%- include('../partials/footer') %>
