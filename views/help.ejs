<%- include('partials/header') %><header class="page-heading"><p class="eyebrow">Sherubtse TripHub</p><h1>Help & Frequently Asked Questions</h1><p class="lead">Answers and published trip guidance currently available on the platform.</p></header><section class="help-content"><h2>Frequently Asked Questions</h2><% if(!faqs.length){ %><p class="empty-state">No FAQs have been published yet.</p><% }else{ faqs.forEach(f=>{ %><details class="faq-item"><summary><%= f.question %></summary><div class="faq-answer"><%= f.answer %></div></details><% }) } %><h2>Trip Guidelines & Policies</h2><p class="small-muted">These platform guidelines do not replace DSA permission, official college requirements, or required consent documents.</p><% if(!guidelines.length){ %><p class="empty-state">No guidelines have been published yet.</p><% }else{ guidelines.forEach(g=>{ %><article class="guideline-item"><h3><%= g.title %></h3><p><%= g.body %></p></article><% }) } %></section><%- include('partials/footer') %>
