<%- include('../partials/header') %>
<header class="page-heading"><h1>DSA: <%= trip.title %></h1><p class="lead">Check every approved participant and verified consent letter before formally approving the current package.</p></header>
<section class="surface-card section-block"><p><strong>Platform departure clearance:</strong> <%= cleared?'Cleared':'Not cleared for departure' %></p><p><%= rows.length %> of <%= trip.max_participants %> places are confirmed. A smaller valid list is acceptable.</p><ol><% rows.forEach(p=>{ %><li><%= p.name %> — <%= p.verification_status||'Unverified' %> consent v<%= p.consent_version||'?' %></li><% }); %></ol></section>
<section class="surface-card section-block"><h2>Review submitted versions</h2><% if(!submissions.length){ %><p>No submissions yet.</p><% } %><% submissions.forEach(s=>{ %><article class="section-block"><h3>Version <%= s.submission_number %> — <%= s.review_status %></h3><p><a href="/workspace/final-namelist-packages/<%= s.id %>/pdf?preview=1" target="_blank" rel="noopener">Preview</a> · <a href="/workspace/final-namelist-packages/<%= s.id %>/pdf">Private download</a></p><% if(s.review_status==='pending_dsa'&&!s.invalidated_at){ %><form method="post" action="/workspace/dsa/final-namelists/<%= trip.id %>/submissions/<%= s.id %>/decision" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>DSA remarks (required for corrections or rejection)<textarea name="remarks" maxlength="1500"></textarea></label><div class="action-row"><button name="action" value="approve" class="btn btn-primary">Approve namelist</button><button name="action" value="changes_requested" class="btn btn-outline">Request corrections</button><button name="action" value="reject" class="btn btn-outline">Reject package</button></div></form><% } %></article><% }); %></section>
<section class="surface-card section-block"><h2>Decision history</h2><% events.forEach(e=>{ %><p><%= e.action %> — <%= e.actor_name||'System' %> — <%= e.remarks||'' %></p><% }); %></section>
<%- include('../partials/footer') %>
