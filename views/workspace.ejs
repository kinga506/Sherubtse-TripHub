<%- include('partials/header') %>
<div class="student-dashboard">
  <section class="student-welcome">
    <div><p class="eyebrow">STUDENT WORKSPACE</p><h1>Welcome back<% if(firstName){ %>, <%= firstName %><% } %></h1><p class="lead">Plan journeys, track your proposals and manage your college trip participation.</p></div>
    <a class="btn btn-primary" href="/workspace/proposals/new">Create a Proposal</a>
  </section>

  <section class="dashboard-stats" aria-label="Your trip activity">
    <article class="dashboard-stat"><span class="dashboard-stat-icon" aria-hidden="true">▤</span><div><p>My Proposals</p><strong><%= overview.counts.proposals %></strong></div></article>
    <article class="dashboard-stat"><span class="dashboard-stat-icon" aria-hidden="true">⌖</span><div><p>My Trips</p><strong><%= overview.counts.participations %></strong></div></article>
    <article class="dashboard-stat"><span class="dashboard-stat-icon" aria-hidden="true">◇</span><div><p>Coordinating Trips</p><strong><%= overview.counts.coordinating %></strong></div></article>
  </section>

  <section class="dashboard-section" aria-labelledby="quick-actions-heading">
    <div class="section-heading"><div><p class="eyebrow">GET STARTED</p><h2 id="quick-actions-heading">Quick Actions</h2></div></div>
    <div class="quick-action-grid">
      <article class="quick-action-card"><span class="quick-action-icon" aria-hidden="true">＋</span><h3>Organise a Trip</h3><p>Create a new proposal and submit it for DSA review.</p><a class="btn btn-outline" href="/workspace/proposals/new">Create Proposal</a></article>
      <article class="quick-action-card"><span class="quick-action-icon" aria-hidden="true">▤</span><h3>My Proposals</h3><p>Track drafts, submitted proposals and DSA decisions.</p><a class="btn btn-outline" href="/workspace/proposals">View My Proposals</a></article>
      <article class="quick-action-card"><span class="quick-action-icon" aria-hidden="true">⌖</span><h3>My Trips</h3><p>View joining requests, participation status and trip information.</p><a class="btn btn-outline" href="/workspace/my-trips">View My Trips</a></article>
      <% if(overview.counts.coordinating){ %><article class="quick-action-card"><span class="quick-action-icon" aria-hidden="true">◇</span><h3>My Coordinating Trips</h3><p>Manage trips assigned to you as a coordinator.</p><a class="btn btn-outline" href="/workspace/coordinating-trips">Manage Coordinating Trips</a></article><% } %>
    </div>
    <% if(!overview.counts.coordinating){ %><p class="coordinator-note">No coordinating trips yet. Trips assigned to you by DSA will appear here.</p><% } %>
  </section>

  <section class="dashboard-section recent-activity" aria-labelledby="recent-activity-heading">
    <div class="section-heading"><div><p class="eyebrow">YOUR LATEST UPDATES</p><h2 id="recent-activity-heading">Recent Activity</h2></div><a class="text-link" href="/workspace/my-trips">View My Trips</a></div>
    <% if(overview.activity.length){ %><ul class="activity-list"><% overview.activity.forEach(function(item){ %><li><span class="activity-mark" aria-hidden="true"></span><div><strong><%= item.title %></strong><p><%= item.kind === 'proposal' ? 'Proposal' : 'Participation request' %> · <span class="status-label"><%= String(item.status||'').replaceAll('_',' ') %></span></p></div><time datetime="<%= item.activity_at ? new Date(item.activity_at).toISOString() : '' %>"><%= item.activity_at ? new Date(item.activity_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : 'Date unavailable' %></time></li><% }); %></ul><% } else { %><div class="compact-empty"><span aria-hidden="true">✦</span><div><strong>Your next journey starts with a proposal.</strong><p>Start planning a trip for the Sherubtse community.</p></div><a class="text-link" href="/workspace/proposals/new">Create Proposal →</a></div><% } %>
  </section>
</div>
<%- include('partials/footer') %>
