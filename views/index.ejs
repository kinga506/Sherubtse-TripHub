<%- include('partials/header') %>
<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="eyebrow">Sherubtse College · Kanglung, Bhutan</p>
    <h1 id="hero-heading">Your next college journey <span>starts here.</span></h1>
    <p class="lead">Discover destinations, plan meaningful trips and stay connected with the Sherubtse community.</p>
    <div class="button-row">
      <% if (currentUser) { %>
        <a class="btn btn-primary" href="/workspace/<%= currentUser.role === 'admin' ? 'superadmin' : currentUser.role %>">Go to my dashboard <span aria-hidden="true">→</span></a>
        <a class="btn btn-outline" href="/destinations">Explore Destinations</a>
      <% } else { %>
        <a class="btn btn-primary" href="/auth/signup">Create Student Account <span aria-hidden="true">→</span></a>
        <a class="btn btn-outline" href="/destinations">Explore Destinations</a>
      <% } %>
    </div>
  </div>
  <div class="hero-art" aria-hidden="true"><div class="hero-orb"></div><svg viewBox="0 0 450 360"><path d="M0 275 110 128 192 245 278 93 450 275V360H0Z" fill="#98c2ad"/><path d="M0 292 127 175 193 265 312 119 450 286V360H0Z" fill="#4c9275"/><path d="M0 335Q96 280 193 321T450 299V360H0Z" fill="#164d40"/><path d="M159 360c-12-38 94-39 74-75-13-24 60-27 41-51" stroke="#e8d8ac" stroke-width="16" stroke-linecap="round" fill="none"/><circle cx="365" cy="80" r="29" fill="#f1d78f"/></svg><span class="hero-art-caption">Journeys begin with a plan</span></div>
</section>

<section class="section-block home-workflow" aria-labelledby="workflow-heading">
  <div class="section-heading"><div><p class="eyebrow">A CLEAR PATH FOR EVERY TRIP</p><h2 id="workflow-heading">How TripHub Works</h2><p class="home-section-subtitle">From your first idea to your next college journey.</p></div></div>
  <ol class="workflow-grid">
    <li class="workflow-card"><span class="workflow-number">01</span><span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3>Propose</h3><p>Create and submit a college trip proposal.</p></li>
    <li class="workflow-card"><span class="workflow-number">02</span><span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.7"/></svg></span><h3>Get Approved</h3><p>DSA reviews the proposal and approved trips become eligible for publication.</p></li>
    <li class="workflow-card"><span class="workflow-number">03</span><span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3 11.5 12 4l9 7.5M5.5 10v10h13V10M9 20v-6h6v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3>Join &amp; Prepare</h3><p>Students request participation, submit consent and prepare under coordinator supervision.</p></li>
  </ol>
</section>

<section class="section-block home-destinations" aria-labelledby="destinations-heading">
  <div class="section-heading"><div><p class="eyebrow">EXPLORE EASTERN BHUTAN</p><h2 id="destinations-heading">Find a place to begin</h2><p class="home-section-subtitle">Discover places using the project’s destination guides and photographs.</p></div><a class="text-link" href="/destinations">Explore all destinations <span aria-hidden="true">→</span></a></div>
  <% if(destinations.length){ %>
    <div class="destination-grid home-destination-grid">
      <% destinations.forEach(d=>{ %><article class="destination-card"><a class="destination-image" href="/destinations/<%= d.slug %>"><img loading="lazy" src="<%= d.photo || '/images/destination-placeholder.svg' %>" alt="<%= d.alt_text || d.name %>"></a><div class="destination-card-body"><p class="eyebrow"><%= d.dzongkhag %></p><h3><a href="/destinations/<%= d.slug %>"><%= d.name %></a></h3><p><%= d.description %></p><a href="/destinations/<%= d.slug %>" class="text-link">Discover destination <span aria-hidden="true">→</span></a><% if(d.photo_credit){ %><small>Photo: <%= d.photo_credit %></small><% } %></div></article><% }); %>
    </div>
  <% } else { %><p class="home-compact-empty">Destination guides will appear here when available.</p><% } %>
</section>

<section class="section-block home-trips" aria-labelledby="college-trips-heading">
  <div class="section-heading"><div><p class="eyebrow">DSA-APPROVED JOURNEYS</p><h2 id="college-trips-heading">College Trips</h2><p class="home-section-subtitle">A preview of trips currently available for public discovery.</p></div><a class="text-link" href="/trips">View all College Trips <span aria-hidden="true">→</span></a></div>
  <% if(trips.length){ %>
    <div class="home-trip-grid">
      <% trips.forEach(trip=>{ %><article class="home-trip-card"><a class="home-trip-photo" href="/trips/<%= trip.id %>"><img loading="lazy" src="<%= trip.destination_photo || '/images/destination-placeholder.svg' %>" alt="<%= trip.destination_name %> destination photograph"></a><div class="home-trip-body"><div class="trip-status-row"><p class="eyebrow"><%= trip.destination_name %></p><span class="status-badge <%= trip.public_stage==='ongoing'?'badge-success':'badge-info' %>"><%= trip.public_stage==='ongoing'?'Ongoing':'Upcoming' %></span></div><h3><a href="/trips/<%= trip.id %>"><%= trip.title %></a></h3><p class="home-trip-dates"><%= new Date(trip.start_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %> – <%= new Date(trip.end_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %></p></div></article><% }); %>
    </div>
  <% } else { %><div class="home-trip-empty"><span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m3 17 6-7 4 4 4-6 4 9H3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="18" cy="5" r="2" stroke="currentColor" stroke-width="1.7"/></svg></span><p>DSA-approved college journeys will appear here when available.</p></div><% } %>
</section>

<% if(!currentUser){ %><section class="home-signup-cta" aria-labelledby="signup-heading"><div><p class="eyebrow">READY TO GET STARTED?</p><h2 id="signup-heading">Ready to be part of the journey?</h2><p>Create your student account to begin planning and participating in college trips.</p></div><a class="btn btn-primary" href="/auth/signup">Get Started <span aria-hidden="true">→</span></a></section><% } %>
<%- include('partials/footer') %>
