<%- include('../partials/header') %>
<div class="page-heading"><p class="eyebrow">Private trip workspace</p><h1><%= trip.title %></h1><p class="lead">Itinerary and Coordinator announcements. Only approved participants and authorised trip staff can view these details.</p></div>
<% if(trip.approval_status!=='approved'){ %><div class="form-message form-error" role="status">This trip is awaiting DSA reapproval. Itinerary edits and announcements are paused until DSA approves the latest revision.</div><% } %>
<p><a class="btn btn-secondary" href="/workspace/trips/<%= trip.id %>/packing">Packing checklist and suggestions</a> <a class="btn btn-secondary" href="/workspace/trips/<%= trip.id %>/finance" data-step15-link="true">Trip finances / my contributions</a> <a class="btn btn-secondary" href="/workspace/trips/<%= trip.id %>/attendance">Attendance</a></p>
<div class="print-actions"><button type="button" class="btn btn-secondary" onclick="window.print()">Print itinerary</button></div>
<section class="surface-card section-block" id="itinerary"><h2>Detailed itinerary</h2>
<% if(!itinerary.length){ %><p>No itinerary activities are available.</p><% } %>
<% let day=null; itinerary.forEach(function(activity){ %>
<% if(day!==activity.day_number){day=activity.day_number; %><h3>Day <%= day %></h3><% } %>
<article class="itinerary-entry"><p><strong><%= activity.start_time||'Time to be confirmed' %> — <%= activity.title %></strong></p><p><%= activity.description||'No additional description.' %></p>
<% if(canEdit){ %><details class="coordinator-action"><summary>Edit activity</summary><form method="post" class="stack-form" action="/workspace/trips/<%= trip.id %>/updates/activities/<%= activity.id %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Day <input type="number" min="1" max="365" name="day_number" value="<%= activity.day_number %>" required></label><label>Time <input type="time" name="start_time" value="<%= activity.start_time||'' %>"></label><label>Title <input name="title" maxlength="160" required value="<%= activity.title %>"></label><label>Description <textarea name="description" maxlength="3000"><%= activity.description||'' %></textarea></label>
<p class="helper-text">Saving a material itinerary change closes registration and sends a new proposal version to DSA for review.</p><button type="submit" class="btn btn-primary">Save and request DSA reapproval</button></form>
<form method="post" action="/workspace/trips/<%= trip.id %>/updates/activities/<%= activity.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-secondary">Remove activity and request reapproval</button></form></details><% } %>
</article><% }); %></section>
<% if(canEdit){ %><section class="surface-card section-block coordinator-action"><h2>Add itinerary activity</h2><form class="stack-form" method="post" action="/workspace/trips/<%= trip.id %>/updates/activities"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Day number <input type="number" name="day_number" min="1" max="365" required></label><label>Time <input type="time" name="start_time"></label><label>Title <input name="title" maxlength="160" required></label><label>Description <textarea name="description" maxlength="3000"></textarea></label><p>Adding an activity is a material change and requires fresh DSA approval. Registration will close.</p><button class="btn btn-primary" type="submit">Add and submit revision to DSA</button></form></section><% } %>
<section class="surface-card section-block coordinator-action" id="announcements"><h2>Trip announcements</h2>
<% if(!announcements.length){%><p>No announcements have been posted yet.</p><%}%>
<% announcements.forEach(function(a){%><article class="notice-entry"><h3><%= a.title %> <% if(a.is_important){%><span class="status-badge badge-info">Important</span><%}%></h3><p><%= a.body %></p><p class="helper-text">Posted by <%= a.author_name %> · <%= new Date(a.created_at).toLocaleString('en-GB') %></p></article><% }); %>
<% if(canEdit){ %><h3>Publish an announcement</h3><form class="stack-form" method="post" action="/workspace/trips/<%= trip.id %>/updates/announcements"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title <input name="title" maxlength="160" required></label><label>Message <textarea name="body" maxlength="5000" required></textarea></label><label><input type="checkbox" name="is_important"> Mark important</label><button class="btn btn-primary" type="submit">Publish announcement</button></form><% } %>
</section>
<%- include('../partials/footer') %>
