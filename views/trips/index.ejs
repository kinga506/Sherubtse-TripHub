<%- include('../partials/header') %>
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">College Trips</span></nav>
<header class="page-heading"><p class="eyebrow">Approved college journeys</p><h1>College Trips</h1><p class="lead">Explore approved trips that are open for public discovery. Trips may appear before registration opens, and ongoing trips remain listed through their end date.</p></header>
<% if(trips.length){ %>
 <p class="small-muted" role="status"><%= trips.length %> eligible college <%= trips.length===1?'trip':'trips' %>. Estimated costs are per student, in Bhutanese Ngultrum.</p>
 <div class="trip-discovery-grid"><% trips.forEach(trip=>{ %>
  <article class="trip-public-card">
   <a href="/trips/<%= trip.id %>" class="trip-public-photo"><img loading="lazy" src="<%= trip.destination_photo || '/images/destination-placeholder.svg' %>" alt="<%= trip.destination_name %> destination photograph"></a>
   <div class="trip-public-body">
    <div class="trip-status-row"><p class="eyebrow"><%= trip.destination_name %> · <%= trip.dzongkhag %></p><span class="status-badge <%= trip.public_stage==='ongoing'?'badge-success':'badge-info' %>"><%= trip.public_stage==='ongoing'?'Ongoing':'Upcoming' %></span></div>
    <h2><a href="/trips/<%= trip.id %>"><%= trip.title %></a></h2>
    <p><%= trip.description || 'Trip information is available on the details page.' %></p>
    <p><strong>Dates:</strong> <%= new Date(trip.start_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %> – <%= new Date(trip.end_date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}) %></p>
    <p><strong>Estimated cost / student:</strong> Nu. <%= Number(trip.estimated_cost).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></p>
    <p><strong>Seats:</strong> <%= trip.occupied_seats %>/<%= trip.max_participants %> occupied · <%= trip.confirmed_participants %> confirmed · <%= trip.registration.available %> available</p>
    <span class="status-badge <%= trip.registration.key==='open'?'badge-success':'badge-neutral' %>"><%= trip.registration.label %></span>
    <p><a href="/trips/<%= trip.id %>" class="text-link">View costs, safety and trip details →</a></p>
   </div>
  </article>
 <% }) %></div>
<% } else { %>
 <section class="empty-state college-trips-empty surface-card" aria-labelledby="no-trips-heading">
  <span class="empty-state-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="m5 35 13-19 8 12 6-8 11 15" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 40h34" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="36" cy="11" r="3" fill="currentColor"/></svg></span>
  <h2 id="no-trips-heading">No college trips available</h2>
  <p>DSA-approved college trips will appear here when announced. Please check back for upcoming journeys.</p>
 </section>
<% } %>
<%- include('../partials/footer') %>
