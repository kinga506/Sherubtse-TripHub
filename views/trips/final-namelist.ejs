<%- include('../partials/header') %>
<header class="page-heading"><p class="eyebrow">Trip Coordinator</p><h1>Final participant namelist — <%= trip.title %></h1><p class="lead">This platform clearance is separate from the official Student Travel Form and any required college permission.</p></header>
<section class="surface-card section-block"><h2>Departure clearance</h2><p><strong><%= cleared ? 'Cleared in TripHub' : 'Not cleared for departure' %></strong></p><p><%= rows.length %> approved participants / <%= trip.max_participants %> maximum places. Unfilled places do not prevent submission.</p>
<% if(rows.length){ %><ol><% rows.forEach(p=>{ %><li><%= p.name %> — consent version <%= p.consent_version||'missing' %> (<%= p.verification_status||'not verified' %>)</li><% }); %></ol><% }else{ %><p>No approved participants.</p><% } %>
<% if(isLead){ %><form method="post" action="/workspace/trips/<%= trip.id %>/final-namelist/submit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit">Generate and submit final namelist & consent package</button></form><p class="form-hint">Only verified current consent letters are included. If DSA review is already pending, you must wait for its decision before resubmitting.</p><% } %></section>
<section class="surface-card section-block"><h2>Submitted packages</h2><% if(!submissions.length){ %><p>No packages submitted yet.</p><% } %><% submissions.forEach(s=>{ %><p><strong>Version <%= s.submission_number %></strong> — <%= s.review_status %> — <%= new Date(s.submitted_at).toLocaleString('en-GB') %> · <a href="/workspace/final-namelist-packages/<%= s.id %>/pdf?preview=1" target="_blank" rel="noopener">Preview PDF</a> · <a href="/workspace/final-namelist-packages/<%= s.id %>/pdf">Download PDF</a></p><% }); %></section>
<section class="surface-card section-block"><h2>Audit history</h2><% events.forEach(e=>{ %><p><%= e.action %> · <%= e.actor_name||'System' %> · <%= new Date(e.created_at).toLocaleString('en-GB') %> <%= e.remarks||'' %></p><% }); %></section>
<%- include('../partials/footer') %>
