
<%- include('../partials/header') %>

<header class="page-heading">
  <p class="eyebrow">Student Workspace</p>
  <h1>My Coordinating Trips</h1>
  <p class="lead">
    Manage trips assigned to you by DSA.
    Your account remains a Student account.
  </p>
</header>

<% if (visibilityNotice) { %>
  <p class="visibility-toast-source" data-toast-on-load role="status"><%= visibilityNotice==='hidden'?'Trip hidden from College Trips. Registration and participant records were not changed.':'Trip shown on College Trips.' %></p>
<% } %>

<% if (!trips.length) { %>
  <section class="surface-card section-block">
    <h2>No Coordinating Trips</h2>
    <p>
      You currently have no active Lead Coordinator
      assignments.
    </p>
    <a class="btn btn-primary" href="/workspace/student">
      Back to Student Dashboard
    </a>
  </section>
<% } %>

<% trips.forEach(function(trip) { %>

<section class="surface-card section-block">

  <div class="page-heading">
    <p class="eyebrow"><%= trip.assignment_role==='lead'?'Lead':'Assistant' %> Trip Coordinator</p>
    <h2><%= trip.title %></h2>
    <p>
      You are responsible for coordinating this trip
      under DSA supervision.
    </p>
  </div>

  <section class="public-visibility-panel" aria-labelledby="visibility-title-<%= trip.id %>">
    <div>
      <p class="eyebrow">PUBLIC VISIBILITY</p>
      <h3 id="visibility-title-<%= trip.id %>">Public visibility</h3>
      <p><span class="status-badge <%= trip.public_visibility_state==='public'?'badge-success':trip.public_visibility_state==='hidden'?'badge-neutral':'badge-info' %>"><%= trip.public_visibility_label %></span></p>
      <p class="small-muted">This controls discovery on the College Trips page only. It does not cancel the trip, close registration, or change participants, consent records, namelist clearance, or Coordinator assignments.</p>
    </div>
    <% if (trip.assignment_role==='lead' && trip.public_eligible) { %>
      <button class="btn <%= trip.public_visibility_state==='hidden'?'btn-primary':'btn-outline' %>" type="button"
        data-public-visibility-trigger data-trip-id="<%= trip.id %>"
        data-next-action="<%= trip.public_visibility_state==='hidden'?'show':'hide' %>"
        data-registration-open="<%= trip.registration_open?'true':'false' %>">
        <%= trip.public_visibility_state==='hidden'?'Show in College Trips':'Hide from College Trips' %>
      </button>
    <% } else if (trip.assignment_role!=='lead') { %>
      <p class="small-muted">Only the active lead Trip Coordinator can change public visibility.</p>
    <% } %>
  </section>

  <div class="feature-grid">

    <article class="feature-card">
      <h3>Registration Management</h3>
      <p>
        Open or close registration and manage
        available participant slots.
      </p>
      <a class="btn btn-primary"
         href="/workspace/trips/<%= trip.id %>/registration">
        Manage Registration
      </a>
    </article>

    <article class="feature-card">
      <h3>Student Applications</h3>
      <p>
        Review registration requests and
        verify consent letters.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/requests">
        Review Applications
      </a>
    </article>

    <article class="feature-card">
      <h3>Itinerary and Announcements</h3>
      <p>
        Manage trip schedules, activities
        and participant announcements.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/updates">
        Manage Updates
      </a>
    </article>

    <article class="feature-card">
      <h3>Final Participant List</h3>
      <p>
        Prepare the confirmed participant list
        and consent package for DSA review.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/final-namelist">
        Final Namelist
      </a>
    </article>

    <article class="feature-card">
      <h3>Packing Suggestions</h3>
      <p>
        Prepare recommended items and
        equipment for the trip.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/packing">
        Packing Checklist
      </a>
    </article>

    <article class="feature-card">
      <h3>Expenses and Contributions</h3>
      <p>
        Manage estimated expenses and
        participant contributions.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/finance">
        Manage Finances
      </a>
    </article>

    <article class="feature-card">
      <h3>Attendance</h3>
      <p>
        Record student attendance and
        export attendance information.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/attendance">
        Manage Attendance
      </a>
    </article>

    <article class="feature-card">
      <h3>Official Travel Form</h3>
      <p>
        Prepare the official Student Travel Form
        for required signatures.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/student-travel-form">
        Travel Form
      </a>
    </article>

    <article class="feature-card">
      <h3>Trip Feedback</h3>
      <p>
        View feedback submitted by
        eligible participants.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/feedback/summary">
        View Feedback
      </a>
    </article>

    <article class="feature-card">
      <h3>Trip Changes</h3>
      <p>
        Request DSA review before making
        material changes to the trip.
      </p>
      <a class="btn btn-secondary"
         href="/workspace/trips/<%= trip.id %>/revise">
        Request DSA Review
      </a>
    </article>

  </div>

  <details class="surface-card section-block">
    <summary>
      <strong>Request Coordinator Handover</strong>
    </summary>

    <p>
      If you cannot continue coordinating this trip,
      submit a handover request to DSA.
      DSA must approve any Coordinator replacement.
    </p>

    <form method="post"
          action="/workspace/trips/<%= trip.id %>/request-handover"
          class="stack-form">

      <input type="hidden"
             name="_csrf"
             value="<%= csrfToken %>">

      <label>
        Reason for Handover
        <textarea name="reason"
                  maxlength="2000"
                  required></textarea>
      </label>

      <button type="submit" class="btn btn-outline">
        Request DSA Handover
      </button>

    </form>
  </details>

</section>

<% }); %>

<dialog class="triphub-modal visibility-modal" id="public-visibility-modal" aria-labelledby="public-visibility-modal-title" aria-describedby="public-visibility-modal-message">
  <form method="post" id="public-visibility-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="action" id="public-visibility-action">
    <p class="eyebrow">CONFIRM VISIBILITY CHANGE</p>
    <h2 id="public-visibility-modal-title">Change public visibility?</h2>
    <p id="public-visibility-modal-message"></p>
    <p class="visibility-registration-warning" id="public-visibility-registration-warning" hidden>If registration remains open, new students will no longer discover this trip through the public gallery. Registration will remain open.</p>
    <label for="public-visibility-reason">Optional reason</label>
    <textarea id="public-visibility-reason" name="reason" maxlength="500" rows="3"></textarea>
    <div class="triphub-modal-actions">
      <button type="button" class="btn btn-outline" data-public-visibility-cancel>Cancel</button>
      <button type="submit" class="btn btn-primary" id="public-visibility-confirm">Confirm</button>
    </div>
  </form>
</dialog>

<%- include('../partials/footer') %>
