NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sherubtse_triphub
DB_USER=postgres
DB_PASS=replace-with-your-local-postgres-password
DB_SSL=false

# Defaults to true. Set false for a PostgreSQL-only temporary beta deployment.
ENABLE_MONGODB=true
MONGO_URI=mongodb://127.0.0.1:27017/sherubtse_triphub_feedback

EMAIL_MODE=log
EMAIL_PROVIDER=resend
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=private_uploads
ALLOW_EPHEMERAL_STORAGE=false
