NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

DB_HOST=replace-with-your-neon-hostname
DB_PORT=5432
DB_NAME=neondb
DB_USER=replace-with-your-neon-role
DB_PASS=replace-with-your-neon-password
DB_SSL=true

# MongoDB is optional. Keep false for a PostgreSQL-only beta.
ENABLE_MONGODB=false

EMAIL_MODE=api
EMAIL_PROVIDER=google-apps-script
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
GOOGLE_SCRIPT_SECRET=replace-with-a-new-shared-secret

ALLOWED_EMAIL_SUFFIX=.sherubtse@rub.edu.bt
DEMO_MODE=false
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=private_uploads
ALLOW_EPHEMERAL_STORAGE=false
